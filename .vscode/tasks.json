{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "api:dev",
			"type": "shell",
			"command": "pnpm",
			"args": ["-C", "apps/api", "dev"],
			"isBackground": true,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "api:create-admin",
			"type": "shell",
			"command": "curl",
			"args": [
				"-sS",
				"-X",
				"POST",
				"http://localhost:4000/api/users",
				"-H",
				"Content-Type: application/json",
				"-d",
				"{\"name\":\"Admin User\",\"email\":\"admin@nova.com\",\"password\":\"Admin12345\",\"role\":\"ADMIN\"}"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "api:health",
			"type": "shell",
			"command": "curl",
			"args": ["-sS", "http://127.0.0.1:4000/api/health"],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "api:kill-4000",
			"type": "shell",
			"command": "sh",
			"args": ["-lc", "lsof -ti tcp:4000 | xargs -r kill -9"],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "api:dev",
			"type": "shell",
			"command": "pnpm",
			"args": ["-C", "apps/api", "dev"],
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "api:health",
			"type": "shell",
			"command": "curl",
			"args": ["-sS", "http://127.0.0.1:4000/api/health"],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "api:dev-detached",
			"type": "shell",
			"command": "sh",
			"args": [
				"-lc",
				"pnpm -C apps/api dev >/tmp/nova-api-dev.log 2>&1 & echo API_STARTED pid=$!"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "api:health2",
			"type": "shell",
			"command": "curl",
			"args": ["-sS", "http://127.0.0.1:4000/api/health"],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "api:create-admin-fixed",
			"type": "shell",
			"command": "sh",
			"args": [
				"-lc",
				"curl -sS -X POST http://127.0.0.1:4000/api/users -H \"Content-Type: application/json\" -d \"{\\\"name\\\":\\\"Admin User\\\",\\\"email\\\":\\\"admin@nova.com\\\",\\\"password\\\":\\\"Admin12345\\\",\\\"role\\\":\\\"ADMIN\\\"}\""
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "api:list-users",
			"type": "shell",
			"command": "sh",
			"args": [
				"-lc",
				"curl -sS http://127.0.0.1:4000/api/users | head -c 400 ; echo"
			],
			"isBackground": false,
			"problemMatcher": []
		}
	]
}
