{
	"$schema": "https://turborepo.com/schema.json",
	"ui": "tui",
	"globalEnv": [
		"API_BASE_URL",
		"API_URL",
		"NEXT_PUBLIC_API_BASE_URL",
		"NEXT_PUBLIC_API_URL",
		"NODE_ENV"
	],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": [".next/**", "!.next/cache/**", "dist/**", "build/**"]
		},
		"lint": {
			"dependsOn": ["^lint"]
		},
		"check-types": {
			"dependsOn": ["^check-types"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"api#dev": {
			"env": [
				"MONGO_URI",
				"JWT_SECRET",
				"PORT",
				"FRONTEND_URL",
				"PAYPAL_MODE",
				"PAYPAL_CLIENT_ID",
				"PAYPAL_CLIENT_SECRET",
				"PAYPAL_BASE_URL",
				"WEB_BASE_URL",
				"SOCKET_CORS_ORIGINS",
				"CLIENT_ORIGIN",
				"NEXT_PUBLIC_APP_URL"
			]
		}
	}
}
