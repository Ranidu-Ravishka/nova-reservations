{
	"name": "nova-reservations",
	"private": true,
	"scripts": {
		"build": "turbo run build",
		"build:web": "turbo run build --filter=web",
		"build:admin": "turbo run build --filter=admin",
		"dev": "turbo run dev",
		"dev:web": "turbo run dev --filter=web",
		"dev:admin": "turbo run dev --filter=admin",
		"dev:api": "turbo run dev --filter=api",
		"lint": "biome check .",
		"format": "biome check . --write",
		"typecheck": "turbo run check-types"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.8",
		"@types/dotenv": "^8.2.3",
		"@types/express": "^5.0.6",
		"@types/node": "^22.19.7",
		"@types/socket.io": "^3.0.2",
		"prettier": "^3.6.2",
		"turbo": "^2.6.3",
		"typescript": "5.9.2"
	},
	"packageManager": "pnpm@9.0.0",
	"engines": {
		"node": ">=18"
	},
	"dependencies": {
		"@paypal/react-paypal-js": "^8.9.2",
		"axios": "^1.13.2",
		"bcrypt": "^6.0.0",
		"cors": "^2.8.5",
		"dotenv": "^17.2.3",
		"express": "^5.2.1",
		"framer-motion": "^12.28.1",
		"jsonwebtoken": "^9.0.3",
		"lucide-react": "^0.562.0",
		"mongoose": "^9.1.5",
		"next-themes": "^0.4.6",
		"paypal-rest-sdk": "^1.8.1",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"socket.io": "^4.8.3",
		"ws": "^8.19.0"
	}
}
