{
	"extends": "@repo/typescript-config/nextjs.json",
	"compilerOptions": {
		/* Next.js */
		"plugins": [{ "name": "next" }],

		"ignoreDeprecations": "5.0",

		/* Module resolution */
		"baseUrl": ".",
		"paths": {
			"@/*": ["./*"]
		},

		/* Type safety */
		"strict": true,
		"noUncheckedIndexedAccess": true,

		/* Build & DX */
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,

		/* Output */
		"noEmit": true
	},
	"include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
	"exclude": ["node_modules"]
}
